root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.rs]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

# Windows 批处理：cmd.exe 按系统 ANSI 代码页(zh-CN = GBK)解析文件字节，
# 用 UTF-8 会让多字节字符错位（会把注释当命令执行）；且批处理必须 CRLF。
# 故此处显式豁免上面的 charset=utf-8 / end_of_line=lf。
# 说明与验收口径见 scripts/start-desktop.bat 头部注释。
[*.{bat,cmd}]
charset = gbk
end_of_line = crlf
insert_final_newline = false
