{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EveryoneCoding",
  "version": "0.1.0",
  "identifier": "com.everyonecoding.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @ec/renderer dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @ec/renderer build",
    "frontendDist": "../../renderer/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "EveryoneCoding",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "resources": ["../../../LICENSE", "../../../NOTICE"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"],
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/2595001965/everyoneCoding/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyNUM0QzgzQzczQ0Y0NgpSV1JHejNNOHlNUWxEZnRYcTBVZWQ5OXJoUGRyanhDUFIyQ2RwTFE1NzdKZVhYc3VXcmRIRGFsdwo=",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
